@model mf_dev_backend2026.Models.Usuario

@{
    ViewData["Title"] = "Detalhes do Usuário";
}

<h1>Detalhes do Usuário</h1>
<hr />

<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Nome)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Nome)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Perfil)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Perfil)</dd>
</dl>

<div>
    <a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
    <a asp-action="Index" class="btn btn-info">Voltar</a>
</div>