@model IEnumerable<mf_dev_backend2026.Models.Consumo>

@{
    ViewData["Title"] = "Relatório do Veículo";
}

<h1>Relatório do veículo @ViewBag.Veiculo.Nome</h1>
<h4>Valor total gasto: @(((decimal)ViewBag.Total).ToString("C"))</h4>

<table class="table">
    <thead>
        <tr>
            <th>Descrição</th>
            <th>Data</th>
            <th>Valor</th>
            <th>Combustível</th>
            <th>Quilometragem</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Descricao</td>
            <td>@item.Data.ToString("dd/MM/yyyy")</td>
            <td>@item.Valor.ToString("C")</td>
            <td>@Html.DisplayFor(m => item.TipoCombustivel)</td>
            <td>@item.Quilometragem</td>
        </tr>
    }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-info">Voltar</a>
