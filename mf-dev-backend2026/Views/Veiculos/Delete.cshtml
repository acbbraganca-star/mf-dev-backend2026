@model mf_dev_backend2026.Models.Veículo

@{
    ViewData["Title"] = "Apagar Veículo";
}

<h1>Apagar veículo</h1>
<h3 class="text-danger">Tem certeza de que deseja apagar este registro?</h3>
<hr />

<dl class="row">
    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Nome)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Nome)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Placa)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.Placa)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.AnoFabricacao)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.AnoFabricacao)</dd>

    <dt class="col-sm-2">@Html.DisplayNameFor(model => model.AnoModelo)</dt>
    <dd class="col-sm-10">@Html.DisplayFor(model => model.AnoModelo)</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Apagar" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>